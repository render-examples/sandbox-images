{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "/opt/render/runtime/contracts.ts": [
        "../../../runtime/contracts.ts",
        "../../runtime/contracts.ts"
      ],
      "/opt/render/runtime/coding-agent-workload.ts": [
        "../../../runtime/coding-agent-workload.ts",
        "../../runtime/coding-agent-workload.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../smoke.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
