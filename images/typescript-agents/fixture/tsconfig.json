{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "/opt/render/runtime/contracts.ts": [
        "/opt/render/runtime/contracts.ts",
        "../../../runtime/contracts.ts"
      ]
    },
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "*.ts"
  ]
}
