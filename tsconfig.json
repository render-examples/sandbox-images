{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "/opt/render/runtime/*": ["./runtime/*"]
    }
  },
  "include": ["runtime/**/*.ts", "scripts/**/*.ts", "tools/**/*.ts", "images/**/*.ts", "snapshots/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist", "**/.venv", "**/evidence", "artifacts"]
}
